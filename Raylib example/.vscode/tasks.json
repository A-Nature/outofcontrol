{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-g",
                "-std=c++17",
                "-I/opt/homebrew/include",
                "-L/opt/homebrew/lib",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}/main",
                "-lraylib",
                "-framework", "IOKit",
                "-framework", "Cocoa",
                "-framework", "OpenGL"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "command": "mingw32-make",
                "args": []
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/raylib/w64devkit/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/raylib/w64devkit/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.",
            "osx": {
                "command": "/usr/bin/clang++",
                "args": [
                    "-fdiagnostics-color=always",
                    "-g",
                    "-std=c++17",
                    "-I/opt/homebrew/include",
                    "-L/opt/homebrew/lib",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}",
                    "-lraylib",
                    "-framework", "IOKit",
                    "-framework", "Cocoa",
                    "-framework", "OpenGL"
                ],
                "options": {
                    "cwd": "${fileDirname}"
                }
            }
        }
    ]
}